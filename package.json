{
  "name": "hk-tetracube-well",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "DEV_HTTPS=1 vite",
    "dev:server": "tsx watch src/server/main.ts",
    "start:server": "node dist-server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:client": "vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --target=node20 --format=esm --packages=external --sourcemap --outfile=dist-server/main.js",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "preview": "vite preview",
    "test": "vitest --run",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.1",
    "fastify": "5.2.0",
    "mongodb": "6.12.0",
    "three": "0.170.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
